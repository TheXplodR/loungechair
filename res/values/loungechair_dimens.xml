    <dimen name="loungechair_all_apps_row_height">60dp</dimen>
    <dimen name="loungechair_all_apps_row_padding">12dp</dimen>
    <dimen name="loungechair_all_apps_row_icon_size">44dp</dimen>
    <dimen name="loungechair_all_apps_row_icon_text_gap">16dp</dimen>
    <dimen name="loungechair_all_apps_row_text_size">18sp</dimen>
    <dimen name="loungechair_all_apps_section_letter_size">26sp</dimen>
    <dimen name="loungechair_all_apps_section_letter_inset">5dp</dimen>
</resources>
